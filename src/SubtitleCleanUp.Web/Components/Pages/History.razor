@page "/history"
@rendermode InteractiveServer
@inject IDbContextFactory<SubtitleCleanupDbContext> DbFactory
@inject ChangeExecutionService Executor

<PageTitle>History & recovery · SubtitleCleanUp</PageTitle>

<header class="page-header">
    <div><p class="eyebrow">Audit trail</p><h1>History &amp; recovery</h1><p class="lede">Restore quarantined subtitles or permanently purge them when you are certain.</p></div>
</header>
@if (_notice is not null) { <div class="notice @(_noticeIsError ? "error" : "success")" role="status">@_notice</div> }

<div class="history-grid">
    <section class="panel">
        <div class="panel-heading"><div><p class="eyebrow">Recoverable</p><h2>Quarantine</h2></div><span class="badge">@_quarantine.Count files</span></div>
        @if (_quarantine.Count == 0)
        {
            <div class="empty-state"><span>◇</span><h3>Quarantine is empty</h3><p>Approved duplicate removals will appear here.</p></div>
        }
        else
        {
            <div class="operation-list">
                @foreach (var operation in _quarantine)
                {
                    <div class="operation-row">
                        <div><strong>@Path.GetFileName(operation.SourcePath)</strong><small>@operation.Proposal?.MediaStem · @operation.OccurredUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small><code title="@operation.SourcePath">@operation.SourcePath</code></div>
                        <div class="operation-actions">
                            <button class="button secondary small" @onclick="() => RestoreAsync(operation.Id)">Restore</button>
                            @if (_purgeConfirmation == operation.Id)
                            {
                                <button class="button danger small" @onclick="() => PurgeAsync(operation.Id)">Confirm purge</button>
                                <button class="button ghost small" @onclick="() => _purgeConfirmation = null">Cancel</button>
                            }
                            else { <button class="button ghost small" @onclick="() => _purgeConfirmation = operation.Id">Purge</button> }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
    <section class="panel">
        <div class="panel-heading"><div><p class="eyebrow">Scanner activity</p><h2>Recent scans</h2></div></div>
        <div class="timeline">
            @foreach (var run in _runs)
            {
                <div class="timeline-item">
                    <span class="timeline-dot @(run.Status == "Failed" ? "failed" : "")"></span>
                    <div>
                        <strong>@run.Status</strong><small>@run.StartedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @run.DiscoveredCount files · @run.ProposedCount proposals</small>
                        @if (run.Error is not null) { <p class="error-text">@run.Error</p> }
                        @foreach (var issue in run.Issues) { <p class="warning-text">@issue.Message</p> }
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<section class="panel all-history">
    <div class="panel-heading"><div><p class="eyebrow">Immutable log</p><h2>All file operations</h2></div></div>
    <div class="table-wrap"><table><thead><tr><th>When</th><th>Operation</th><th>Source</th><th>Destination</th><th>Status</th></tr></thead>
        <tbody>@foreach (var operation in _operations)
        {
            <tr><td>@operation.OccurredUtc.ToLocalTime().ToString("MMM d, HH:mm")</td><td>@operation.Type</td><td title="@operation.SourcePath">@Path.GetFileName(operation.SourcePath)</td><td title="@operation.DestinationPath">@Path.GetFileName(operation.DestinationPath)</td><td><span class="status-pill @operation.Status.ToString().ToLowerInvariant()">@operation.Status</span></td></tr>
        }</tbody></table></div>
</section>

@code {
    private List<FileOperationRecord> _quarantine = [], _operations = [];
    private List<ScanRun> _runs = [];
    private int? _purgeConfirmation;
    private string? _notice;
    private bool _noticeIsError;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _quarantine = await db.FileOperations.AsNoTracking().Include(x => x.Proposal).Where(x => x.Type == OperationType.Quarantine && x.Status == OperationStatus.Applied).OrderByDescending(x => x.OccurredUtc).ToListAsync();
        _operations = await db.FileOperations.AsNoTracking().OrderByDescending(x => x.OccurredUtc).Take(100).ToListAsync();
        _runs = await db.ScanRuns.AsNoTracking().Include(x => x.Issues).OrderByDescending(x => x.StartedUtc).Take(10).ToListAsync();
    }
    private async Task RestoreAsync(int id)
    {
        try { await Executor.RestoreAsync(id); _noticeIsError = false; _notice = "Subtitle restored to its original location."; await LoadAsync(); }
        catch (Exception ex) { _noticeIsError = true; _notice = $"Restore failed: {ex.Message}"; }
    }
    private async Task PurgeAsync(int id)
    {
        try { await Executor.PurgeAsync(id); _noticeIsError = false; _notice = "Quarantined file permanently purged."; _purgeConfirmation = null; await LoadAsync(); }
        catch (Exception ex) { _noticeIsError = true; _notice = $"Purge failed: {ex.Message}"; }
    }
}
