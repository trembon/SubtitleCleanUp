@page "/"
@rendermode InteractiveServer
@inject IDbContextFactory<SubtitleCleanupDbContext> DbFactory
@inject ScanCoordinator ScanCoordinator
@inject ScanScheduler Scheduler
@inject OperationGate Gate
@inject IOptions<SubtitleCleanupOptions> Options
@implements IDisposable

<PageTitle>Dashboard · SubtitleCleanUp</PageTitle>

<header class="page-header">
    <div>
        <p class="eyebrow">Library overview</p>
        <h1>Your subtitles, under control.</h1>
        <p class="lede">Scan for inconsistent language tags and duplicates. Safe rename-only fixes are applied automatically; duplicates still require approval.</p>
    </div>
    <button class="button primary" disabled="@(_scanning || Gate.IsBusy)" @onclick="ScanNowAsync">
        @(_scanning ? "Scanning…" : "Scan now")
    </button>
</header>

@if (_notice is not null)
{
    <div class="notice @(_noticeIsError ? "error" : "success")" role="status">@_notice</div>
}

<section class="metric-grid" aria-label="Scan summary">
    <article class="metric-card accent">
        <span>Needs review</span>
        <strong>@_pending</strong>
        <small>@_duplicates duplicate groups · @_renames renames</small>
    </article>
    <article class="metric-card">
        <span>Protected files</span>
        <strong>@_quarantined</strong>
        <small>Available to restore or purge</small>
    </article>
    <article class="metric-card">
        <span>Last scan</span>
        <strong class="compact">@FormatRelative(_lastRun?.CompletedUtc)</strong>
        <small>@(_lastRun is null ? "No scan has finished yet" : $"{_lastRun.DiscoveredCount} subtitles examined")</small>
    </article>
    <article class="metric-card">
        <span>Next scheduled scan</span>
        <strong class="compact">@FormatDate(Scheduler.NextScanUtc)</strong>
        <small>@Options.Value.ScanCron · @Options.Value.TimeZone</small>
    </article>
</section>

<div class="dashboard-grid">
    <section class="panel">
        <div class="panel-heading">
            <div><p class="eyebrow">Review queue</p><h2>Proposed cleanups</h2></div>
            <a class="text-link" href="/review">Review all →</a>
        </div>
        @if (_recent.Count == 0)
        {
            <div class="empty-state"><span>✓</span><h3>No pending cleanups</h3><p>Run a scan to inspect your mounted media folders.</p></div>
        }
        else
        {
            <div class="proposal-list compact-list">
                @foreach (var item in _recent)
                {
                    <a class="proposal-row" href="/review">
                        <span class="file-kind @(item.Kind == ProposalKind.Duplicate ? "warning" : "")">
                            @(item.Kind == ProposalKind.Duplicate ? "DUP" : item.Kind == ProposalKind.Rename ? "REN" : "CHK")
                        </span>
                        <span><strong>@item.MediaStem</strong><small>@item.RootName · @item.Language@Variant(item.Variant)</small></span>
                        <span class="row-target">@(item.CanonicalPath is null ? "Manual check" : Path.GetFileName(item.CanonicalPath))</span>
                    </a>
                }
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-heading"><div><p class="eyebrow">Configuration</p><h2>Watched locations</h2></div></div>
        <div class="root-list">
            @foreach (var root in Options.Value.Roots)
            {
                <div class="root-row"><span class="folder-icon">⌑</span><span><strong>@root.Name</strong><code>@root.Path</code></span></div>
            }
        </div>
        @if (_lastRun?.Issues.Count > 0)
        {
            <div class="warning-box">
                <strong>Scan warnings</strong>
                @foreach (var issue in _lastRun.Issues) { <p>@issue.Message</p> }
            </div>
        }
    </section>
</div>

@code {
    private int _pending, _duplicates, _renames, _quarantined;
    private bool _scanning, _noticeIsError;
    private string? _notice;
    private ScanRun? _lastRun;
    private List<ChangeProposal> _recent = [];

    protected override async Task OnInitializedAsync()
    {
        Gate.StateChanged += OnGateStateChanged;
        await LoadAsync();
    }

    private void OnGateStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Gate.StateChanged -= OnGateStateChanged;

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _pending = await db.ChangeProposals.CountAsync(x => x.Status == ProposalStatus.Pending);
        _duplicates = await db.ChangeProposals.CountAsync(x => x.Status == ProposalStatus.Pending && x.Kind == ProposalKind.Duplicate);
        _renames = await db.ChangeProposals.CountAsync(x => x.Status == ProposalStatus.Pending && x.Kind == ProposalKind.Rename);
        _quarantined = await db.FileOperations.CountAsync(x => x.Type == OperationType.Quarantine && x.Status == OperationStatus.Applied);
        _lastRun = await db.ScanRuns.Include(x => x.Issues).OrderByDescending(x => x.StartedUtc).FirstOrDefaultAsync();
        _recent = await db.ChangeProposals.AsNoTracking().Where(x => x.Status == ProposalStatus.Pending)
            .OrderByDescending(x => x.Kind == ProposalKind.Duplicate).ThenByDescending(x => x.CreatedUtc).Take(5).ToListAsync();
    }

    private async Task ScanNowAsync()
    {
        _scanning = true; _notice = null; _noticeIsError = false;
        try
        {
            await ScanCoordinator.ScanAsync();
            _notice = "Scan complete. The review queue has been refreshed.";
            await LoadAsync();
        }
        catch (Exception ex) { _noticeIsError = true; _notice = $"Scan failed: {ex.Message}"; }
        finally { _scanning = false; }
    }

    private static string FormatRelative(DateTimeOffset? value) =>
        value is null ? "Never" :
        DateTimeOffset.UtcNow - value.Value < TimeSpan.FromMinutes(1) ? "Just now" :
        DateTimeOffset.UtcNow - value.Value < TimeSpan.FromHours(1) ? $"{(int)(DateTimeOffset.UtcNow - value.Value).TotalMinutes} min ago" :
        value.Value.ToLocalTime().ToString("MMM d, HH:mm");
    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("MMM d, HH:mm") ?? "Calculating…";
    private static string Variant(string? value) => value is null ? string.Empty : $" · {value}";
}
