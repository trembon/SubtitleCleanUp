{
  "ConnectionStrings": {
    "SubtitleCleanup": "Data Source=../../data/subtitlecleanup.db"
  },
  "SubtitleCleanup": {
    "Roots": [
      {
        "Name": "media",
        "Path": "./media"
      }
    ],
    "ScanCron": "0 3 * * *",
    "TimeZone": "Europe/Stockholm",
    "ScanOnStartup": true,
    "QuarantineRoot": "../../data/quarantine",
    "PreviewMaxBytes": 2097152
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
